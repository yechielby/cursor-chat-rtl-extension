{
  "name": "cursor-chat-rtl",
  "displayName": "Cursor Chat RTL Support",
  "description": "Adds an ⇄ toggle button to Cursor IDE chat for Hebrew, Arabic, Persian, Urdu, and other RTL languages, switching messages to right-aligned RTL via CSS while keeping code blocks and UI in LTR. Patches Cursor workbench files (not VS Code). Restart Cursor after activation.",
  "version": "0.1.10",
  "publisher": "yechielby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YechielBy/cursor-chat-rtl-extension"
  },
  "homepage": "https://github.com/yechielby/cursor-chat-rtl-extension#readme",
  "bugs": {
    "url": "https://github.com/yechielby/cursor-chat-rtl-extension/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "arabic",
    "balochi",
    "bidi",
    "bidirectional",
    "chat-rtl",
    "cursor",
    "cursor-ai",
    "cursor-app",
    "cursor-chat",
    "cursor-ide",
    "cursor-only",
    "dari",
    "dhivehi",
    "farsi",
    "hebrew",
    "kurdish",
    "pashto",
    "persian",
    "right-to-left",
    "rtl",
    "rtl-support",
    "sindhi",
    "syriac",
    "text-direction",
    "toggle-rtl",
    "urdu",
    "uyghur",
    "yiddish"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "cursor-chat-rtl-logo.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-rtl.add",
        "title": "Cursor Chat RTL: Activate"
      },
      {
        "command": "cursor-rtl.remove",
        "title": "Cursor Chat RTL: Deactivate"
      },
      {
        "command": "cursor-rtl.status",
        "title": "Cursor Chat RTL: Check Status"
      },
      {
        "command": "cursor-rtl.diagnose",
        "title": "Cursor Chat RTL: Diagnose Selectors"
      }
    ],
    "configuration": {
      "title": "Cursor Chat RTL",
      "properties": {
        "cursorChatRtl.mixedTextDetection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When RTL is on (⇄), right-align paragraphs that start with an English word but contain RTL text such as Hebrew, Arabic, Persian, or Urdu (e.g. `Cursor הוא עורך קוד`). Turn off if it misbehaves or slows the chat. Takes effect after **Reload Window**."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "compile": "node esbuild.mjs",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
